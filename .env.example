# ====================
# 教务系统配置
# ====================
ZFSOFT_BASE_URL=https://jw.your-school.edu.cn
ZFSOFT_USERNAME=your_username
ZFSOFT_PASSWORD=your_password

# ====================
# 应用配置（可选）
# ====================
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 是否启用GPU加速
USE_GPU=true

# 人脸识别阈值
FACE_THRESHOLD=0.70
